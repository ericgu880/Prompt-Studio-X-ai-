{
  "manifest_version": 3,
  "name": "PromptStudio Web Capture",
  "version": "1.0.6",
  "description": "Local text and image capture for PromptStudio.",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selection.js", "image-capture.js", "content-core.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PromptStudio"
  }
}
